import { useState } from 'react';
import { db } from '../db/db';
import { useLiveQuery } from 'dexie-react-hooks';
import {
  Settings as SettingsIcon, Shield, Zap, Globe,
  Database, Sliders, Monitor, Terminal, Download, Trash2,
  Eye, EyeOff, Plus, X, CheckCircle2, RefreshCw, Bot,
  Palette, Bell, Lock, MousePointer2, Network, FlaskConical, Save
} from 'lucide-react';
import { motion, AnimatePresence } from 'motion/react';
import { cn } from '../lib/utils';

type Tab = 'general' | 'appearance' | 'apis' | 'agent';

interface ApiEntry {
  id: string; label: string; key: string;
  endpoint?: string; status: 'active' | 'error' | 'pending'; addedAt: number;
}
interface AgentBrowserConfig {
  mode: 'headless' | 'overlay';
  injectionDelayMs: number;
  allowedDomains: string[];
  screenshotOnAction: boolean;
  autoRetry: boolean;
  maxRetries: number;
  scrollBehavior: 'smooth' | 'instant' | 'disabled';
  highlightSelectors: boolean;
  stealthMode: boolean;
}
interface AppearanceConfig {
  accentColor: string; hudOpacity: number; compactMode: boolean;
  animationsEnabled: boolean; fontSize: 'xs' | 'sm' | 'base';
  dashboardLayout: 'grid' | 'list'; showPnlOnDash: boolean; glowEffects: boolean;
}

const DEFAULT_AGENT: AgentBrowserConfig = {
  mode: 'headless', injectionDelayMs: 120,
  allowedDomains: ['prizepicks.com', 'draftkings.com', 'fanduel.com'],
  screenshotOnAction: false, autoRetry: true, maxRetries: 3,
  scrollBehavior: 'smooth', highlightSelectors: true, stealthMode: false,
};
const DEFAULT_APPEARANCE: AppearanceConfig = {
  accentColor: '#FF6B00', hudOpacity: 90, compactMode: false,
  animationsEnabled: true, fontSize: 'sm', dashboardLayout: 'grid',
  showPnlOnDash: true, glowEffects: true,
};
const ACCENT_PRESETS = [
  { label: 'Blaze', color: '#FF6B00' }, { label: 'Cyan',  color: '#04BEFE' },
  { label: 'Lime',  color: '#84CC16' }, { label: 'Violet',color: '#A855F7' },
  { label: 'Rose',  color: '#F43F5E' }, { label: 'Amber', color: '#F59E0B' },
];

function useLocalStorage<T>(key: string, init: T): [T, (v: T) => void] {
  const [val, setVal] = useState<T>(() => {
    try { return JSON.parse(localStorage.getItem(key) ?? '') as T; }
    catch { return init; }
  });
  const save = (v: T) => { localStorage.setItem(key, JSON.stringify(v)); setVal(v); };
  return [val, save];
}
function maskKey(k: string) {
  if (k.length <= 8) return '••••••••';
  return k.slice(0, 4) + '••••••••' + k.slice(-4);
}

function Toggle({ on, onToggle }: { on: boolean; onToggle: () => void }) {
  return (
    <button onClick={onToggle}
      className={cn('w-11 h-6 rounded-full flex items-center px-0.5 transition-all duration-300',
        on ? 'bg-brand-primary shadow-[0_0_10px_rgba(255,107,0,0.4)]' : 'bg-white/10'
      )} aria-pressed={on}>
      <motion.div layout transition={{ type: 'spring', stiffness: 500, damping: 30 }}
        className={cn('w-5 h-5 rounded-full bg-white shadow-md', on ? 'ml-auto' : 'ml-0')} />
    </button>
  );
}
function SectionLabel({ children }: { children: React.ReactNode }) {
  return <p className="text-[10px] font-bold text-gray-500 uppercase font-mono tracking-widest mb-2">{children}</p>;
}
function SettingRow({ icon: Icon, label, sub, children }:
  { icon?: React.ElementType; label: string; sub?: string; children: React.ReactNode }) {
  return (
    <div className="flex items-center justify-between gap-3">
      <div className="flex items-center gap-2 min-w-0">
        {Icon && <Icon className="w-3.5 h-3.5 text-gray-500 shrink-0" />}
        <div className="min-w-0">
          <p className="text-[11px] font-semibold text-white">{label}</p>
          {sub && <p className="text-[9px] text-gray-500 font-mono">{sub}</p>}
        </div>
      </div>
      <div className="shrink-0">{children}</div>
    </div>
  );
}

export default function Settings() {
  const settings = useLiveQuery(() => db.settings.get(1));
  const [activeTab, setActiveTab] = useState<Tab>('general');
  const [isExporting, setIsExporting] = useState(false);
  const [saved, setSaved] = useState(false);

