                        className="w-full bg-black/30 p-2.5 rounded-lg border border-white/5 text-[11px] font-mono focus:border-brand-primary outline-none"
                        value={newApi.label} onChange={e => setNewApi(p => ({ ...p, label: e.target.value }))} />
                      <input placeholder="API Key" type="password"
                        className="w-full bg-black/30 p-2.5 rounded-lg border border-white/5 text-[11px] font-mono focus:border-brand-primary outline-none"
