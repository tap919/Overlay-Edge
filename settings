    setApis([...apis, entry]);
    setNewApi({ label: '', key: '', endpoint: '' });
    setAddingApi(false);
  };
  const removeApi = (id: string) => setApis(apis.filter(a => a.id !== id));
  const testApi = async (id: string) => {
    setTestingId(id);
    await new Promise(r => setTimeout(r, 1200));
    setApis(apis.map(a => a.id === id ? { ...a, status: Math.random() > 0.25 ? 'active' : 'error' } : a));
    setTestingId(null);
