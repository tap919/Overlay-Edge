          )}

          {activeTab === 'agent' && (
            <motion.div key="agent" initial={{ opacity: 0, x: 10 }} animate={{ opacity: 1, x: 0 }} exit={{ opacity: 0, x: -10 }} className="space-y-6">
              <div className="space-y-3">
                <SectionLabel>Interaction Mode</SectionLabel>
                <div className="grid grid-cols-2 gap-2">
                  {(['headless', 'overlay'] as const).map(m => (
                    <button key={m} onClick={() => { updateAgent('mode', m); showSaved(); }}
                      className={cn('p-3 rounded-xl border text-[10px] font-bold uppercase transition-all',
                        agentCfg.mode === m
                          ? 'border-brand-secondary bg-brand-secondary/10 text-brand-secondary shadow-[0_0_12px_rgba(4,190,254,0.15)]'
