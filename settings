                      className={cn('p-2.5 rounded-xl border text-[10px] font-bold uppercase transition-all',
                        appearance.dashboardLayout === l ? 'border-brand-primary bg-brand-primary/10 text-brand-primary' : 'border-white/5 bg-white/5 text-gray-500'
