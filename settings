    updateAgent('allowedDomains', agentCfg.allowedDomains.filter(x => x !== d));

  const exportData = async () => {
    setIsExporting(true);
    const bets = await db.bets.toArray();
    const blob = new Blob(
      [JSON.stringify({ bets, apis: apis.map(a => ({ ...a, key: '***REDACTED***' })), agentCfg }, null, 2)],
      { type: 'application/json' }
    );
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'overlay_edge_backup.json';
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    setIsExporting(false);
  };
  const clearData = async () => {
    if (!confirm('DANGER: Delete ALL bet data? Cannot be undone.')) return;
    await db.bets.clear(); await db.liveMarkets.clear();
    alert('Database cleared.');
