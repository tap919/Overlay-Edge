  const addApi = () => {
    if (!newApi.label || !newApi.key) return;
    const entry: ApiEntry = {
      id: crypto.randomUUID(), label: newApi.label.toUpperCase(),
      key: newApi.key, endpoint: newApi.endpoint || undefined,
      status: 'pending', addedAt: Date.now(),
