                <div className="space-y-3">
                  <SettingRow icon={MousePointer2} label="Highlight Selectors" sub="Visually mark elements the agent targets">
                    <Toggle on={agentCfg.highlightSelectors} onToggle={() => { updateAgent('highlightSelectors', !agentCfg.highlightSelectors); showSaved(); }} />
                  </SettingRow>
                  <SettingRow icon={Monitor} label="Screenshot on Action" sub="Capture state before each action">
                    <Toggle on={agentCfg.screenshotOnAction} onToggle={() => { updateAgent('screenshotOnAction', !agentCfg.screenshotOnAction); showSaved(); }} />
                  </SettingRow>
                  <SettingRow icon={RefreshCw} label="Auto Retry" sub="Re-attempt failed actions automatically">
                    <Toggle on={agentCfg.autoRetry} onToggle={() => { updateAgent('autoRetry', !agentCfg.autoRetry); showSaved(); }} />
                  </SettingRow>
                  <SettingRow icon={Shield} label="Stealth Mode" sub="Randomise timing + fingerprint spoofing">
                    <Toggle on={agentCfg.stealthMode} onToggle={() => { updateAgent('stealthMode', !agentCfg.stealthMode); showSaved(); }} />
                  </SettingRow>
                </div>
              </div>
              {agentCfg.autoRetry && (
                <div className="space-y-2">
                  <SectionLabel>Max Retries</SectionLabel>
                  <div className="flex items-center gap-3">
                    <input type="range" min={1} max={10} value={agentCfg.maxRetries}
                      onChange={e => { updateAgent('maxRetries', +e.target.value); showSaved(); }}
                      className="flex-1 accent-brand-primary h-1.5 rounded-full appearance-none bg-white/10" />
                    <span className="text-[10px] font-mono text-brand-primary w-6 text-right">{agentCfg.maxRetries}x</span>
                  </div>
                </div>
              )}
              <div className="space-y-3">
                <SectionLabel>Allowed Domains</SectionLabel>
                <div className="flex gap-2">
                  <input placeholder="e.g. prizepicks.com"
                    className="flex-1 bg-black/20 p-2 rounded-lg border border-white/5 text-[10px] font-mono focus:border-brand-secondary outline-none"
                    value={newDomain} onChange={e => setNewDomain(e.target.value)}
                    onKeyDown={e => e.key === 'Enter' && addDomain()} />
                  <button onClick={addDomain}
                    className="px-3 bg-brand-secondary/10 border border-brand-secondary/30 text-brand-secondary rounded-lg text-[10px] font-bold hover:bg-brand-secondary/20 transition-colors">
                    <Plus className="w-3.5 h-3.5" />
                  </button>
                </div>
                <div className="flex flex-wrap gap-1.5">
                  {agentCfg.allowedDomains.map(d => (
                    <div key={d} className="flex items-center gap-1 bg-white/5 border border-white/5 rounded-full px-2.5 py-1">
                      <Network className="w-2.5 h-2.5 text-brand-secondary" />
                      <span className="text-[9px] font-mono text-gray-300">{d}</span>
                      <button onClick={() => { removeDomain(d); showSaved(); }} className="text-gray-600 hover:text-red-400 ml-0.5">
                        <X className="w-2.5 h-2.5" />
                      </button>
                    </div>
                  ))}
                </div>
              </div>
              <div className="p-4 bg-brand-secondary/5 rounded-xl border border-brand-secondary/20 space-y-2">
                <p className="text-[10px] font-bold uppercase flex items-center gap-2 text-white">
                  <Terminal className="w-3.5 h-3.5 text-brand-secondary" /> Automation Log
                </p>
                <div className="p-3 bg-black/40 rounded-lg font-mono text-[9px] text-gray-500 space-y-1 max-h-32 overflow-y-auto">
                  <p>> agent.init() — mode: {agentCfg.mode}</p>
                  <p>> delay: {agentCfg.injectionDelayMs}ms | retries: {agentCfg.maxRetries}</p>
                  <p>> domains: [{agentCfg.allowedDomains.join(', ')}]</p>
                  <p>> stealth: {agentCfg.stealthMode ? 'ON' : 'OFF'} | screenshot: {agentCfg.screenshotOnAction ? 'ON' : 'OFF'}</p>
                  <p className="text-brand-secondary animate-pulse">> standing_by_for_dispatch...</p>
                </div>
              </div>
            </motion.div>
          )}

        </AnimatePresence>
      </div>

      <div className="p-5 bg-brand-primary/5 rounded-2xl border border-brand-primary/10 text-center">
        <p className="text-[10px] text-brand-primary font-bold uppercase tracking-widest mb-1">Neural Firmware</p>
        <p className="text-[10px] text-gray-500 font-mono uppercase">v1.5.0-ALPHA_BUILD_RX9</p>
      </div>
    </div>
  );
}
