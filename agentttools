// ─── Dispatcher ───────────────────────────────────────────────────────────────

export async function executeTool(
  name: string,
  args: Record<string, any>,
): Promise<ToolResult> {
  try {
    switch (name) {
      // ── Data Tools ───────────────────────────────────────────────────────

      case 'sync_odds': {
        const sport = args.sport ?? 'basketball_nba';
        const count = await syncLiveOdds(sport);
        return { ok: true, data: { count, sport, message: `Synced ${count} games for ${sport}` } };
      }

      case 'scan_edge': {
        const settings = await db.settings.get(1);
        const bankroll = settings?.bankroll ?? 1000;
        const result = await scanForEdge(bankroll);
        return { ok: true, data: result };
      }

      case 'calculate_kelly': {
        const { odds, win_probability } = args;
        const settings = await db.settings.get(1);
        const bankroll = settings?.bankroll ?? 1000;
        const result = kellyBreakdown(win_probability, odds, bankroll);
        return { ok: true, data: result };
      }

      case 'get_bet_history': {
        const limit = args.limit ?? 10;
        const statusFilter = args.status ?? 'ALL';
        let bets = await db.bets.orderBy('timestamp').reverse().limit(limit * 3).toArray();
        if (statusFilter !== 'ALL') {
          bets = bets.filter(b => b.status === statusFilter);
        }
        bets = bets.slice(0, limit);

        const settled = bets.filter(b => b.status !== BetStatus.PENDING);
        const wins = settled.filter(b => b.status === BetStatus.WIN).length;
        const totalProfit = settled.reduce((s, b) => s + (b.resultProfit ?? 0), 0);
        const totalStaked = settled.reduce((s, b) => s + b.stake, 0);

        return {
          ok: true,
          data: {
            bets: bets.map(b => ({
              sport: b.sport,
              teams: b.teams.join(' vs '),
              betType: b.betType,
              odds: b.odds,
              stake: b.stake,
              status: b.status,
              profit: b.resultProfit ?? 0,
              bookmaker: b.bookmaker,
              date: new Date(b.timestamp).toLocaleDateString(),
            })),
            stats: {
              count: settled.length,
              winRate: settled.length > 0 ? ((wins / settled.length) * 100).toFixed(1) + '%' : 'N/A',
              totalProfit: totalProfit.toFixed(2),
              roi: totalStaked > 0 ? ((totalProfit / totalStaked) * 100).toFixed(1) + '%' : 'N/A',
            },
          },
        };
      }

      case 'get_bankroll': {
        const settings = await db.settings.get(1);
        const bets = await db.bets.toArray();
        const settled = bets.filter(b => b.status !== BetStatus.PENDING);
        const wins = settled.filter(b => b.status === BetStatus.WIN);
        const totalProfit = settled.reduce((s, b) => s + (b.resultProfit ?? 0), 0);
        const totalStaked = settled.reduce((s, b) => s + b.stake, 0);
        const pending = bets.filter(b => b.status === BetStatus.PENDING);
        const pendingStake = pending.reduce((s, b) => s + b.stake, 0);

        return {
          ok: true,
          data: {
            bankroll: settings?.bankroll ?? 1000,
            totalProfit: parseFloat(totalProfit.toFixed(2)),
            balance: parseFloat(((settings?.bankroll ?? 1000) + totalProfit).toFixed(2)),
            winRate: settled.length > 0 ? ((wins.length / settled.length) * 100).toFixed(1) + '%' : 'N/A',
            roi: totalStaked > 0 ? ((totalProfit / totalStaked) * 100).toFixed(1) + '%' : 'N/A',
            pendingBets: pending.length,
            pendingStake: parseFloat(pendingStake.toFixed(2)),
            settledBets: settled.length,
          },
        };
      }

      // ── Browser Tools ────────────────────────────────────────────────────

      case 'browser_navigate': {
        const res = await fetch('/api/browser/navigate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: args.url, waitFor: args.wait_for ?? 'domcontentloaded' }),
        });
        const json = await res.json();
        if (!res.ok) return { ok: false, error: json.error };
        return { ok: true, data: json, browserUrl: json.url };
      }

      case 'browser_screenshot': {
        const res = await fetch('/api/browser/screenshot');
        const json = await res.json();
        if (!res.ok) return { ok: false, error: json.error };
        return {
          ok: true,
          data: { url: json.url, message: `Screenshot captured at ${json.url}` },
          screenshot: json.screenshot,
          browserUrl: json.url,
        };
      }

      case 'browser_extract': {
        const res = await fetch('/api/browser/extract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ selector: args.selector, attribute: args.attribute }),
        });
        const json = await res.json();
        if (!res.ok) return { ok: false, error: json.error };
        return { ok: true, data: { content: json.content } };
      }

      case 'browser_click': {
        const res = await fetch('/api/browser/click', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ selector: args.selector }),
        });
        const json = await res.json();
        if (!res.ok) return { ok: false, error: json.error };
        return { ok: true, data: json };
      }

      case 'browser_fill': {
        const res = await fetch('/api/browser/fill', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ selector: args.selector, value: args.value }),
        });
        const json = await res.json();
        if (!res.ok) return { ok: false, error: json.error };
        return { ok: true, data: json };
      }

      default:
        return { ok: false, error: `Unknown tool: "${name}"` };
    }
  } catch (err: any) {
    return { ok: false, error: err?.message ?? 'Tool execution failed' };
  }
}
